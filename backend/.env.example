# Database
DATABASE_URL="postgresql://user:password@localhost:5432/crown_tap_game"

# Server
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_MINI_APP_URL="https://yourdomain.com/app"
TELEGRAM_WEBHOOK_SECRET="webhook-secret-for-verification"

# Admin
ADMIN_PASSWORD_HASH="$2b$10$..."

# Logging
LOG_LEVEL="info"

# Rewards (all values in micro-units, 1 coin = 1,000,000 micro-units)
TAP_REWARD=1000
TASK_REWARD_SMALL=50000
TASK_REWARD_MEDIUM=100000
TASK_REWARD_LARGE=250000
AD_REWARD=10000
REFERRAL_REWARD=500000
REFERRAL_BONUS_REWARD=1000000

# Progression
XP_PER_TAP=1
XP_PER_TASK_SMALL=10
XP_PER_TASK_MEDIUM=25
XP_PER_TASK_LARGE=50
XP_PER_AD=5

# Limits
MAX_TAPS_PER_HOUR=3600
TAP_COOLDOWN_MS=100
TASK_CLAIM_COOLDOWN_HOURS=24

# Ad Provider (if configured)
AD_PROVIDER="none"
AD_PROVIDER_API_KEY=""
AD_PROVIDER_NETWORK_ID=""
