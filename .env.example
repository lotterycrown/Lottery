# Server Configuration
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://localhost:5432/crown_tap_game_prod

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
MINI_APP_NAME=your_mini_app_name
MINI_APP_URL=https://yourdomain.com/app

# Frontend
CLIENT_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Security
JWT_SECRET=generate_with_crypto.randomBytes(32).toString('hex')
SESSION_SECRET=generate_with_crypto.randomBytes(32).toString('hex')
ADMIN_SESSION_EXPIRY=86400000

# Optional: Analytics/Error Tracking
SENTRY_DSN=your_sentry_dsn_if_configured
ANALYTICS_KEY=your_analytics_key_if_configured

# Optional: Advertising Providers
AD_PROVIDER_API_KEY=if_configured_in_production
AD_PROVIDER_SECRET=if_configured_in_production

# Frontend Runtime (Vite)
VITE_API_URL=https://api.yourdomain.com
VITE_CLIENT_URL=https://yourdomain.com
VITE_TELEGRAM_BOT_USERNAME=your_bot_username_here
VITE_MINI_APP_NAME=your_mini_app_name
